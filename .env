### NokoPrint:
NOKOPRINT_VERSION=latest
# NOKOPRINT_OLD_KEY=True
# NOKOPRINT_KEYSTORE_FILE_NAME=revanced.keystore
# NOKOPRINT_ARCHS_TO_BUILD=arm64-v8a
NOKOPRINT_CLI_ARGSF=morphe-cli
NOKOPRINT_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
NOKOPRINT_PATCHES_DL=https://github.com/jkennethcarino/adobo/releases/latest,https://github.com/Nai64/Nai64Patches/releases/latest
NOKOPRINT_PACKAGE_NAME=com.nokoprint
NOKOPRINT_DL_SOURCE=apkeep
NOKOPRINT_APKEEP_DEVICE_NAME=poco_f1
# NOKOPRINT_NORMALIZE_PATCH_NAMES=True
NOKOPRINT_INCLUDE_PATCH=disable-mobile-ads,block-ads-trackers-and-analytics,deactivate-firebase-analytics,deactivate-firebase-performance-monitoring,spoof-advertising-id,unlock-premium
# NOKOPRINT_EXCLUDE_PATCH=
NOKOPRINT_OPTIONS_RAW="
Block ads, trackers, and analytics:
  hosts: ./apks/hosts.txt
  redirectionIp: 0.0.0.0
  isWildcard: true
"

### Reverso:
REVERSO_VERSION=latest
# REVERSO_OLD_KEY=True
# REVERSO_KEYSTORE_FILE_NAME=revanced.keystore
# REVERSO_ARCHS_TO_BUILD=arm64-v8a
REVERSO_CLI_ARGSF=morphe-cli
REVERSO_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
REVERSO_PATCHES_DL=https://github.com/jkennethcarino/adobo/releases/latest,https://github.com/shuhaibnc/morphe-patches/releases/latest
REVERSO_PACKAGE_NAME=com.softissimo.reverso.context
REVERSO_DL_SOURCE=apkeep
REVERSO_APKEEP_DEVICE_NAME=poco_f1
# REVERSO_NORMALIZE_PATCH_NAMES=True
REVERSO_INCLUDE_PATCH=disable-mobile-ads,block-ads-trackers-and-analytics,deactivate-firebase-analytics,deactivate-firebase-performance-monitoring,spoof-advertising-id
# REVERSO_EXCLUDE_PATCH=
REVERSO_OPTIONS_RAW="
Block ads, trackers, and analytics:
  hosts: ./apks/hosts.txt
  redirectionIp: 0.0.0.0
  isWildcard: true
"
