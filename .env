### Global:
GLOBAL_ARCHS_TO_BUILD=arm64-v8a
# GLOBAL_NORMALIZE_PATCH_NAMES=True
# GLOBAL_CLI_ARGSF=revanced-cli
# GLOBAL_CLI_DL=https://github.com/revanced/revanced-cli/releases/latest
# GLOBAL_PATCHES_DL=https://api.revanced.app/v5/patches.rvp
PATCH_APPS=pinterest,tiktok,instagram,proton-vpn,nokoprint,reverso
# EXTRA_FILES=
# EXISTING_DOWNLOADED_APKS=
REPACK_SPLIT_APKS=True

### Pinterest:
# PINTEREST_VERSION=latest_supported
# PINTEREST_OLD_KEY=True
# PINTEREST_KEYSTORE_FILE_NAME=revanced.keystore
# PINTEREST_ARCHS_TO_BUILD=arm64-v8a
PINTEREST_CLI_ARGSF=morphe-cli
PINTEREST_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
PINTEREST_PATCHES_DL=https://github.com/browzomje/browzomje-patches/releases/latest
PINTEREST_PACKAGE_NAME=com.pinterest
PINTEREST_DL_SOURCE=https://www.apkmirror.com/apk/pinterest/pinterest-one-destination-for-a-world-of-inspiration/pinterest
# PINTEREST_NORMALIZE_PATCH_NAMES=True
# PINTEREST_INCLUDE_PATCH=
# PINTEREST_EXCLUDE_PATCH=

