### Proton VPN:
PROTON-VPN_VERSION=latest
# PROTON-VPN_OLD_KEY=True
# PROTON-VPN_KEYSTORE_FILE_NAME=revanced.keystore
# PROTON-VPN_ARCHS_TO_BUILD=arm64-v8a
PROTON-VPN_CLI_ARGSF=morphe-cli
PROTON-VPN_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
PROTON-VPN_PATCHES_DL=https://github.com/hoo-dles/morphe-patches,https://github.com/rushiranpise/morphe-patches,https://gitlab.com/Paresh-Maheshwari/paresh-patches
PROTON-VPN_PACKAGE_NAME=ch.protonvpn.android
PROTON-VPN_DL_SOURCE=apkeep
# PROTON-VPN_NORMALIZE_PATCH_NAMES=True
# PROTON-VPN_INCLUDE_PATCH=
