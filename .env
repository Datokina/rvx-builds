### Global:
GLOBAL_ARCHS_TO_BUILD=arm64-v8a
# GLOBAL_NORMALIZE_PATCH_NAMES=True
# GLOBAL_CLI_ARGSF=revanced-cli
# GLOBAL_CLI_DL=https://github.com/revanced/revanced-cli/releases/latest
# GLOBAL_PATCHES_DL=https://api.revanced.app/v5/patches.rvp
PATCH_APPS=youtube,pinterest,tiktok,instagram,proton-vpn,nokoprint,reverso,bandcamp,musicolet,1dm
# EXTRA_FILES=
# EXISTING_DOWNLOADED_APKS=
APKEEP_DEVICE_FILE=apks/beyond2.properties
REPACK_SPLIT_APKS=True

### YouTube:
# YOUTUBE_VERSION=latest_supported
# YOUTUBE_OLD_KEY=True
# YOUTUBE_KEYSTORE_FILE_NAME=revanced.keystore
# YOUTUBE_ARCHS_TO_BUILD=arm64-v8a
YOUTUBE_CLI_ARGSF=morphe-cli
YOUTUBE_CLI_DL=https://github.com/MorpheApp/morphe-desktop/releases/latest
YOUTUBE_PATCHES_DL=https://github.com/MorpheApp/morphe-patches/releases/latest
# YOUTUBE_NORMALIZE_PATCH_NAMES=True
YOUTUBE_PATCH_SELECTION=DEFAULT,+clone-app,-network-proxy
YOUTUBE_OPTIONS_RAW="
Clone app:
  packageName: app.morphe.android.youtube
"

